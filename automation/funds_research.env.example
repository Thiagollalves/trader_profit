TRADER_PROFIT_FUNDS_LOGIN=
TRADER_PROFIT_FUNDS_PASSWORD=

TRADER_PROFIT_FUNDS_PROFILE_DIR=.cache/trader_profit/funds_research_profile
TRADER_PROFIT_FUNDS_SESSION_STATE=.cache/trader_profit/funds_research_storage.json
