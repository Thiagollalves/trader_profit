TRADER_PROFIT_FUNDS_MAX_FUNDS=
TRADER_PROFIT_FUNDS_MAP_OPEN_PAGE=false
TRADER_PROFIT_FUNDS_MANUAL_LOGIN=false

TRADER_PROFIT_FUNDS_LIST_SELECTOR=
